{
  "model": "sonnet",
  "env": {
    "DEMO_BEARER_TOKEN": "changeme-in-real-env"
  },
  "attribution": {
    "pr": ""
  },
  "cleanupPeriodDays": 30,
  "permissions": {
    "allow": [
      "Bash(uv run uvicorn *)",
      "Bash(uv run python scripts/export_openapi.py)",
      "Bash(uv sync)",
      "Edit(./backend/**)",
      "Edit(./frontend/**)",
      "Edit(./tests/**)",
      "Edit(./openapi.yaml)",
      "WebFetch(domain:fastapi.tiangolo.com)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(rm -rf *)",
      "Bash(git push *)"
    ],
    "ask": [
      "Bash(uv add *)",
      "Bash(uv remove *)"
    ]
  }
}
